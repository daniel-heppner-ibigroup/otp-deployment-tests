{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentripplanner.org/schemas/deployment-test-suite-v2.schema.json",
  "title": "OTP Sentinel test suite",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "locations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonBlankString"
      },
      "additionalProperties": {
        "$ref": "#/$defs/location"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "required": [
    "schemaVersion",
    "tests"
  ],
  "$comment": "Schema validation checks structure, enum values, numeric representation limits, and date/time shape. The loader additionally enforces calendar dates, unique test IDs, location references, and itineraryCountBetween.minimum <= maximum before sending requests.",
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stringSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonBlankString"
      },
      "uniqueItems": true
    },
    "candidates": {
      "$ref": "#/$defs/stringSet",
      "minItems": 1
    },
    "nonNegativeInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "positiveInt": {
      "$ref": "#/$defs/nonNegativeInt",
      "minimum": 1
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807,
      "description": "Whole seconds, representable as a nonnegative Java long."
    },
    "nonNegativeDouble": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.7976931348623157e+308
    },
    "factor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requestMode": {
      "enum": [
        "TRANSIT",
        "WALK",
        "RAIL",
        "BUS",
        "SUBWAY",
        "TRAM",
        "FERRY",
        "CAR",
        "CAR_PARK",
        "SCOOTER_RENT",
        "BICYCLE",
        "BICYCLE_PARK",
        "BICYCLE_RENT",
        "FLEX_DIRECT",
        "FLEX_ACCESS",
        "FLEX_EGRESS",
        "CAR_RENT"
      ]
    },
    "requestModes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requestMode"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "transitMode": {
      "enum": [
        "RAIL",
        "BUS",
        "COACH",
        "SUBWAY",
        "FERRY",
        "TRAM",
        "MONORAIL",
        "CARPOOL",
        "TAXI",
        "CABLE_CAR",
        "AIRPLANE",
        "FUNICULAR",
        "FLEX",
        "GONDOLA",
        "TROLLEYBUS"
      ]
    },
    "searchDirection": {
      "enum": [
        "DEPART_AT",
        "ARRIVE_BY"
      ]
    },
    "transitLegMatching": {
      "enum": [
        "EXACT_ORDERED",
        "ORDERED_SUBSEQUENCE",
        "UNORDERED_SUBSET"
      ]
    },
    "itineraryMatching": {
      "enum": [
        "ANY",
        "ALL",
        "NONE"
      ],
      "default": "ANY",
      "description": "ANY requires at least one matching itinerary; ALL requires a nonempty response and every itinerary to match; NONE requires no matching itinerary and permits an empty response."
    },
    "optimize": {
      "enum": [
        "FLAT",
        "GREENWAYS",
        "QUICK",
        "SAFE",
        "TRIANGLE"
      ]
    },
    "localDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO local date. The loader additionally rejects impossible calendar dates using strict LocalDate parsing."
    },
    "localTime": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?$"
    },
    "serviceDay": {
      "enum": [
        "MONDAY",
        "TUESDAY",
        "WEDNESDAY",
        "THURSDAY",
        "FRIDAY",
        "SATURDAY",
        "SUNDAY"
      ]
    },
    "coordinateLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "coordinate"
        },
        "name": {
          "type": "string"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "type",
        "lat",
        "lon"
      ]
    },
    "stopIdLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stop-id"
        },
        "id": {
          "$ref": "#/$defs/nonBlankString"
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "location": {
      "oneOf": [
        {
          "$ref": "#/$defs/coordinateLocation"
        },
        {
          "$ref": "#/$defs/stopIdLocation"
        }
      ]
    },
    "banned": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routes": {
          "$ref": "#/$defs/stringSet"
        },
        "agencies": {
          "$ref": "#/$defs/stringSet"
        },
        "trips": {
          "$ref": "#/$defs/stringSet"
        },
        "stops": {
          "$ref": "#/$defs/stringSet"
        },
        "stopsHard": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "triangle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "safetyFactor": {
          "$ref": "#/$defs/factor"
        },
        "slopeFactor": {
          "$ref": "#/$defs/factor"
        },
        "timeFactor": {
          "$ref": "#/$defs/factor"
        }
      },
      "required": [
        "safetyFactor",
        "slopeFactor",
        "timeFactor"
      ]
    },
    "requestOptions": {
      "type": "object",
      "description": "Shared defaultable request fields. The enclosing request or requestDefaults rejects unknown properties.",
      "properties": {
        "modes": {
          "$ref": "#/$defs/requestModes"
        },
        "numItineraries": {
          "$ref": "#/$defs/positiveInt"
        },
        "wheelchair": {
          "type": "boolean"
        },
        "searchDirection": {
          "$ref": "#/$defs/searchDirection"
        },
        "searchWindowSeconds": {
          "$ref": "#/$defs/durationSeconds"
        },
        "walkReluctance": {
          "$ref": "#/$defs/nonNegativeDouble"
        },
        "carReluctance": {
          "$ref": "#/$defs/nonNegativeDouble"
        },
        "bikeReluctance": {
          "$ref": "#/$defs/nonNegativeDouble"
        },
        "bikeWalkingReluctance": {
          "$ref": "#/$defs/nonNegativeDouble"
        },
        "walkSpeed": {
          "$ref": "#/$defs/nonNegativeDouble",
          "exclusiveMinimum": 0
        },
        "optimize": {
          "$ref": "#/$defs/optimize"
        },
        "triangle": {
          "$ref": "#/$defs/triangle"
        },
        "banned": {
          "$ref": "#/$defs/banned"
        },
        "pageCursor": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "requestDefaults": {
      "$ref": "#/$defs/requestOptions",
      "unevaluatedProperties": false
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/requestDefaults"
        },
        "transitLegMatching": {
          "$ref": "#/$defs/transitLegMatching"
        }
      }
    },
    "request": {
      "type": "object",
      "$ref": "#/$defs/requestOptions",
      "unevaluatedProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/nonBlankString"
        },
        "to": {
          "$ref": "#/$defs/nonBlankString"
        },
        "serviceDay": {
          "$ref": "#/$defs/serviceDay"
        },
        "date": {
          "$ref": "#/$defs/localDate"
        },
        "time": {
          "$ref": "#/$defs/localTime"
        }
      },
      "required": [
        "from",
        "to",
        "time"
      ],
      "oneOf": [
        {
          "required": [
            "date"
          ],
          "not": {
            "required": [
              "serviceDay"
            ]
          }
        },
        {
          "required": [
            "serviceDay"
          ],
          "not": {
            "required": [
              "date"
            ]
          }
        }
      ]
    },
    "fare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38
        },
        "riderCategoryId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "mediumId": {
          "$ref": "#/$defs/nonBlankString"
        }
      },
      "required": [
        "amount",
        "riderCategoryId",
        "mediumId"
      ]
    },
    "transitLeg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/transitMode"
        },
        "routeShortNames": {
          "$ref": "#/$defs/candidates"
        },
        "routeLongNames": {
          "$ref": "#/$defs/candidates"
        },
        "boardingStopCodes": {
          "$ref": "#/$defs/candidates"
        },
        "boardingStopGtfsIds": {
          "$ref": "#/$defs/candidates"
        },
        "alightingStopCodes": {
          "$ref": "#/$defs/candidates"
        },
        "alightingStopGtfsIds": {
          "$ref": "#/$defs/candidates"
        },
        "interlinedWithPrevious": {
          "type": "boolean"
        },
        "maxDurationSeconds": {
          "$ref": "#/$defs/durationSeconds"
        },
        "fares": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fare"
          },
          "minItems": 1
        }
      },
      "minProperties": 1
    },
    "itinerary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "itineraryMatching": {
          "$ref": "#/$defs/itineraryMatching"
        },
        "transitLegMatching": {
          "$ref": "#/$defs/transitLegMatching"
        },
        "transitLegs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transitLeg"
          }
        },
        "maxDurationSeconds": {
          "$ref": "#/$defs/durationSeconds"
        }
      }
    },
    "itineraryCountBetween": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "maximum": {
          "$ref": "#/$defs/nonNegativeInt"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "description": "Inclusive total itinerary count range. The loader additionally requires minimum <= maximum."
    },
    "expectationList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expectation"
      },
      "minItems": 1
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "itinerary": {
          "$ref": "#/$defs/itinerary"
        },
        "itineraryCountBetween": {
          "$ref": "#/$defs/itineraryCountBetween"
        },
        "allOf": {
          "$ref": "#/$defs/expectationList"
        },
        "anyOf": {
          "$ref": "#/$defs/expectationList"
        }
      },
      "oneOf": [
        {
          "required": [
            "itinerary"
          ]
        },
        {
          "required": [
            "itineraryCountBetween"
          ]
        },
        {
          "required": [
            "allOf"
          ]
        },
        {
          "required": [
            "anyOf"
          ]
        }
      ],
      "description": "Exactly one expression per object. allOf and anyOf recursively compose PlanExpectations; itinerary configures an ItineraryExpectation builder."
    },
    "testIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "name": {
          "$ref": "#/$defs/nonBlankString"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "tripPlanTest": {
      "type": "object",
      "$ref": "#/$defs/testIdentity",
      "properties": {
        "type": {
          "const": "trip-plan"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "expectation": {
          "$ref": "#/$defs/expectation"
        }
      },
      "required": [
        "type",
        "request",
        "expectation"
      ],
      "unevaluatedProperties": false
    },
    "agencyListTest": {
      "type": "object",
      "$ref": "#/$defs/testIdentity",
      "properties": {
        "type": {
          "const": "agency-list"
        },
        "agencies": {
          "$ref": "#/$defs/stringSet"
        }
      },
      "required": [
        "type",
        "agencies"
      ],
      "unevaluatedProperties": false
    },
    "test": {
      "oneOf": [
        {
          "$ref": "#/$defs/tripPlanTest"
        },
        {
          "$ref": "#/$defs/agencyListTest"
        }
      ]
    }
  }
}
