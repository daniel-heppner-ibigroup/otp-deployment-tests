{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentripplanner.org/schemas/deployment-test-suite-v1.schema.json",
  "title": "OTP deployment test suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locations", "tests"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "locations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/nonBlankString"
      },
      "additionalProperties": {
        "$ref": "#/$defs/location"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TRANSIT",
              "WALK",
              "RAIL",
              "BUS",
              "SUBWAY",
              "TRAM",
              "FERRY",
              "CAR",
              "CAR_PARK",
              "SCOOTER_RENT",
              "BICYCLE",
              "BICYCLE_PARK",
              "BICYCLE_RENT",
              "FLEX_DIRECT",
              "FLEX_ACCESS",
              "FLEX_EGRESS",
              "CAR_RENT"
            ]
          }
        },
        "strictTransitMatching": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "name": {
          "type": "string"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "request", "expect"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "name": {
          "$ref": "#/$defs/nonBlankString"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "expect": {
          "$ref": "#/$defs/expectation"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "serviceDay", "time"],
      "properties": {
        "from": {
          "$ref": "#/$defs/nonBlankString"
        },
        "to": {
          "$ref": "#/$defs/nonBlankString"
        },
        "serviceDay": {
          "enum": [
            "MONDAY",
            "TUESDAY",
            "WEDNESDAY",
            "THURSDAY",
            "FRIDAY",
            "SATURDAY",
            "SUNDAY"
          ]
        },
        "time": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?$"
        },
        "searchDirection": {
          "enum": ["DEPART_AT", "ARRIVE_BY"]
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transitLegs"],
      "properties": {
        "transitLegs": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/transitLeg"
                },
                {
                  "properties": {
                    "interlinedWithPrevious": {
                      "const": false
                    }
                  }
                }
              ]
            }
          ],
          "items": {
            "$ref": "#/$defs/transitLeg"
          }
        }
      }
    },
    "transitLeg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "routes"],
      "properties": {
        "mode": {
          "$ref": "#/$defs/nonBlankString"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        },
        "interlinedWithPrevious": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
